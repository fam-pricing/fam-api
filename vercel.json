{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    },
    "api/cron/auto-respond.js": {
      "maxDuration": 60
    },
    "api/cron/auto-followup.js": {
      "maxDuration": 60
    },
    "api/cron/escalation-reminder.js": {
      "maxDuration": 30
    },
    "api/crm/auto-reply.js": {
      "maxDuration": 30
    },
    "api/crm/bot-status.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-respond",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/auto-followup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/escalation-reminder",
      "schedule": "0 * * * *"
    }
  ]
}
